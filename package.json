{
  "name": "@junjiangao/dsh-web-search-tavily",
  "version": "0.3.10",
  "description": "Tavily-backed search provider for the DeepSeek Harness web capability seam (ctx.web): keyless mode, full official search parameters, and the native dsh 0.1.7 plugin configuration form",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "web-search",
    "tavily"
  ],
  "icon": "./icon.svg",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjiangao/dsh-web-search-tavily.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-credentials": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-web": "^0.1.7-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.4",
    "@deepseek-ai/dsh-client-store": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-credentials-local": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-web": "^0.1.7-alpha.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
