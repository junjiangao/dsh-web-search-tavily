{
  "name": "@junjiangao/dsh-web-search-tavily",
  "version": "0.2.0",
  "description": "Tavily-backed search provider for the DeepSeek Harness web capability seam (ctx.web): keyless mode, full official search parameters, settings section, and credentials support",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "web-search",
    "tavily"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjiangao/dsh-web-search-tavily.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.2-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-credentials-local": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.2-alpha.2",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
